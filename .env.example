# Local Development Configuration
# Copy this file and rename to application-local.properties if needed

# Site URL
APP_SITE_URL=http://localhost:8080

# Database Configuration (Update with your credentials)
DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=QLTTNgoaiNgu;encrypt=true;trustServerCertificate=true
DATASOURCE_USERNAME=sa
DATASOURCE_PASSWORD=your_password
DATASOURCE_DRIVER_CLASS_NAME=com.microsoft.sqlserver.jdbc.SQLServerDriver

# JPA Configuration
JPA_HIBERNATE_DDL_AUTO=none
JPA_SHOW_SQL=true
HIBERNATE_DIALECT=org.hibernate.dialect.SQLServerDialect

# JWT Configuration
APP_JWT_SECRET=yourSecretKeyMustBeAtLeast256BitsLongForHS256AlgorithmToWorkProperlyAndSecurely
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_REFRESH_EXPIRATION_MS=604800000
APP_JWT_TOKEN_PREFIX=Bearer 
APP_JWT_HEADER=Authorization

# Liquibase
LIQUIBASE_CHANGELOG=classpath:db/changelog/db.changelog-master.yaml
LIQUIBASE_ENABLED=true

# Gmail SMTP (Update with your credentials)
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_USERNAME=your-email@gmail.com
GMAIL_PASSWORD=your-app-password
GMAIL_SMTP_AUTH=true
GMAIL_SMTP_STARTTLS_ENABLE=true
GMAIL_SMTP_STARTTLS_REQUIRED=true

# VNPay Configuration
VNPAY_RETURN_URL=http://localhost:8080/payment/vnpay-return
VNPAY_FRONTEND_REDIRECT_URL=http://localhost:3000/payment/result
